# Backend environment variables. Names only - set real values in Railway's service variables
# (or in the repo-root .env.local for local dev). Never commit real values.

# Required
DATABASE_URL=
ANTHROPIC_API_KEY=
MODEL=
OPENAI_API_KEY=

# Comma-separated front-end origins allowed to call the API from a browser, e.g. https://web.up.railway.app
CORS_ALLOWED_ORIGINS=

# Unused until a live quote provider needs a key
QUOTE_API_KEY=
